#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

changed_file=$(mktemp)
test_file=$(mktemp)
trap 'rm -f "$changed_file" "$test_file"' EXIT HUP INT TERM
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" != "$zero" ] || continue
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        git diff --name-only --diff-filter=ACMR "$remote_sha" "$local_sha" >> "$changed_file"
    else
        base=$(git merge-base "$local_sha" "refs/remotes/$1/HEAD" 2>/dev/null || true)
        if [ -n "$base" ]; then
            git diff --name-only --diff-filter=ACMR "$base" "$local_sha" >> "$changed_file"
        else
            git diff-tree --root --no-commit-id --name-only -r "$local_sha" >> "$changed_file"
        fi
    fi
done

[ -s "$changed_file" ] || exit 0
sort -u "$changed_file" -o "$changed_file"

frontend=0
spec01=0
spec02=0
while IFS= read -r file; do
    case "$file" in
        Server/app/persistence/*|Server/tests/test_persistence_*.py)
            spec01=1
            printf '%s\n' Server/tests/test_persistence_db.py Server/tests/test_persistence_store.py \
                Server/tests/test_persistence_checkpoints.py >> "$test_file"
            ;;
        Server/app/evolution/fitness.py|Server/app/evolution/evaluation.py|Server/app/evaluation/*|Server/tests/test_fitness*.py|Server/tests/test_evaluation*.py)
            fitness_tests=$(find Server/tests -maxdepth 1 -type f \
                \( -name 'test_fitness*.py' -o -name 'test_evaluation*.py' \))
            if [ -z "$fitness_tests" ]; then
                echo "pre-push: fitness/evaluation changed but no targeted tests exist" >&2
                exit 1
            fi
            printf '%s\n' "$fitness_tests" >> "$test_file"
            ;;
        Server/app/evolution/*|Server/tests/test_evolution_*.py)
            spec02=1
            printf '%s\n' Server/tests/test_evolution_genetic.py >> "$test_file"
            ;;
        Server/app/ai/dqn_agent.py|Server/app/ai/model.py|Server/tests/test_dqn_agent.py)
            printf '%s\n' Server/tests/test_dqn_agent.py >> "$test_file"
            ;;
        Server/app/ai/q_learning_agent.py|Server/tests/test_q_learning_agent.py)
            printf '%s\n' Server/tests/test_q_learning_agent.py >> "$test_file"
            ;;
        Server/app/ai/pong_training_env.py|Server/app/ai/neural_training_service.py|Server/app/ai/multi_agent_training_service.py|Server/tests/test_pong_training_env.py|Server/tests/test_neural_training_service.py|Server/tests/test_multi_agent_training_service.py)
            printf '%s\n' Server/tests/test_pong_training_env.py \
                Server/tests/test_neural_training_service.py \
                Server/tests/test_multi_agent_training_service.py >> "$test_file"
            ;;
        Server/app/ai/service_factory.py|Server/app/sockets.py|Server/tests/test_sockets.py)
            printf '%s\n' Server/tests/test_sockets.py \
                Server/tests/test_neural_training_service.py \
                Server/tests/test_multi_agent_training_service.py >> "$test_file"
            ;;
        Server/tests/test_*.py)
            printf '%s\n' "$file" >> "$test_file"
            ;;
        PongGame/src/*|PongGame/package.json|PongGame/package-lock.json)
            frontend=1
            ;;
    esac
done < "$changed_file"

if [ "$spec01" -eq 1 ] && [ "$spec02" -eq 0 ] && [ -f Server/tests/test_evolution_genetic.py ]; then
    printf '%s\n' \
        'Server/tests/test_evolution_genetic.py::test_lineage_records_integrate_with_spec01_store' \
        >> "$test_file"
fi

if [ -s "$test_file" ]; then
    sort -u "$test_file" -o "$test_file"
    if [ -n "${PYTHON:-}" ]; then
        "$PYTHON" -m pytest $(cat "$test_file")
    elif [ -x .venv/Scripts/python.exe ]; then
        .venv/Scripts/python.exe -m pytest $(cat "$test_file")
    elif [ -x .venv/bin/python ]; then
        .venv/bin/python -m pytest $(cat "$test_file")
    elif command -v python3 >/dev/null 2>&1; then
        python3 -m pytest $(cat "$test_file")
    elif command -v python >/dev/null 2>&1; then
        python -m pytest $(cat "$test_file")
    elif command -v py >/dev/null 2>&1; then
        py -3 -m pytest $(cat "$test_file")
    else
        echo "pre-push: Python/pytest is required for affected backend tests" >&2
        exit 1
    fi
fi

if [ "$frontend" -eq 1 ]; then
    (cd PongGame && "${NPM:-npm}" test && "${NPM:-npm}" run build)
fi
