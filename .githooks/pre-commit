#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

git diff --cached --check

changed=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$changed" ] || exit 0

run_ruff() {
    if [ -x .venv/Scripts/ruff.exe ]; then
        .venv/Scripts/ruff.exe "$@"
    elif [ -x .venv/bin/ruff ]; then
        .venv/bin/ruff "$@"
    elif command -v ruff >/dev/null 2>&1; then
        ruff "$@"
    else
        return 127
    fi
}

ruff_available=0
if [ -x .venv/Scripts/ruff.exe ] || [ -x .venv/bin/ruff ] || command -v ruff >/dev/null 2>&1; then
    ruff_available=1
fi

run_python() {
    if [ -n "${PYTHON:-}" ]; then
        "$PYTHON" "$@"
    elif [ -x .venv/Scripts/python.exe ]; then
        .venv/Scripts/python.exe "$@"
    elif [ -x .venv/bin/python ]; then
        .venv/bin/python "$@"
    elif command -v python3 >/dev/null 2>&1; then
        python3 "$@"
    elif command -v python >/dev/null 2>&1; then
        python "$@"
    elif command -v py >/dev/null 2>&1; then
        py -3 "$@"
    else
        echo "pre-commit: Python is required to check staged .py files" >&2
        return 1
    fi
}

printf '%s\n' "$changed" | while IFS= read -r file; do
    case "$file" in
        .env|*/.env|*.pem|*.key|*.p12|*.pfx|*.sqlite|*.sqlite3|*.db|*.pt|*.pth|*.ckpt)
            echo "pre-commit: refusing sensitive/generated file: $file" >&2
            exit 1
            ;;
    esac

    if git show ":$file" | grep -I -E -q \
        'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9_-]{20,}'; then
        echo "pre-commit: possible secret detected in $file" >&2
        exit 1
    fi

    case "$file" in
        *.py)
            git show ":$file" | run_python -c \
                'import ast, sys; ast.parse(sys.stdin.read(), sys.argv[1])' "$file"
            if [ "$ruff_available" -eq 1 ]; then
                run_ruff check --no-cache "$file"
            fi
            ;;
        *.js|*.mjs|*.cjs)
            if ! command -v node >/dev/null 2>&1; then
                echo "pre-commit: Node.js is required to check staged JavaScript" >&2
                exit 1
            fi
            if git show ":$file" | grep -m1 -E -q '^[[:space:]]*(import|export)[[:space:]]'; then
                git show ":$file" | node --input-type=module --check
            else
                git show ":$file" | node --check
            fi
            ;;
    esac
done

frontend_changed=$(printf '%s\n' "$changed" | grep -E '^PongGame/.*\.(js|mjs|cjs)$' || true)
if [ -n "$frontend_changed" ] && node -e \
    "const p=require('./PongGame/package.json'); process.exit(p.scripts?.lint ? 0 : 1)"; then
    (cd PongGame && "${NPM:-npm}" run lint)
fi
